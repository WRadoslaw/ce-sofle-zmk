// Ported from the Corne config: the 3x6 block and the inner three thumb keys
// match it key for key. The number row, encoder buttons and outer two thumb keys
// on each side only exist on the Sofle.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define SYM 1
#define NAV 2

/ {
    combos {
        compatible = "zmk,combos";

        // Esc + Backspace: forget the currently selected Bluetooth device.
        clear_current_bt {
            bindings = <&bt BT_CLR>;
            key-positions = <12 23>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
// -------------------------------------------------------------------------------------------------
// |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7   |  8  |  9  |  0  |   -   |
// |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U   |  I  |  O  |  P  | BSPC  |
// |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J   |  K  |  L  |  ;  |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   | MUTE |    | PLAY |  N   |  M   |  ,  |  .  |  /  | R-ALT |
//               | GUI | ALT  | CTRL | SYM  | ENTER|    | SPACE| NAV  | ALT  | GUI | DEL |
            bindings = <
&kp GRAVE &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                            &kp N6    &kp N7   &kp N8    &kp N9   &kp N0   &kp MINUS
&kp ESC   &kp Q  &kp W    &kp E    &kp R     &kp T                             &kp Y     &kp U    &kp I     &kp O    &kp P    &kp BSPC
&kp TAB   &kp A  &kp S    &kp D    &kp F     &kp G                             &kp H     &kp J    &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B     &kp C_MUTE  &kp C_PP    &kp N     &kp M    &kp COMMA &kp DOT  &kp FSLH &kp RALT
                 &kp LGUI &kp LALT &kp LCTRL &mo SYM   &kp ENTER   &kp SPACE   &mo NAV   &kp LALT &kp RGUI  &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        symbol_layer {
            display-name = "symbols";
// -------------------------------------------------------------------------------------------------
// |  F1   | F2  | F3  |  F4  |  F5  |  F6  |                   |  F7  |  F8  | F9  | F10 | F11 |  F12  |
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7   |  8  |  9  |  0  | BSPC  |
// |  TAB  |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &   |  *  |  (  |  )  |   |   |
// | SHIFT |  =  |  -  |  +   |  {   |  }   |      |    |      |  [   |  ]   |  ~  |  .  |  \  |   `   |
//               |     |      | GUI  |      |      |    |      |      |      |     |     |
            bindings = <
&kp F1  &kp F2   &kp F3    &kp F4   &kp F5   &kp F6                       &kp F7    &kp F8   &kp F9    &kp F10  &kp F11  &kp F12
&trans  &kp N1   &kp N2    &kp N3   &kp N4   &kp N5                       &kp N6    &kp N7   &kp N8    &kp N9   &kp N0   &trans
&trans  &kp EXCL &kp AT    &kp HASH &kp DLLR &kp PRCNT                    &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &kp PIPE
&trans  &kp EQUAL &kp MINUS &kp PLUS &kp LBRC &kp RBRC  &trans  &trans    &kp LBKT  &kp RBKT &kp TILDE &trans   &kp BSLH &kp GRAVE
                 &trans    &trans   &kp LGUI &trans    &trans  &trans    &trans    &trans   &trans    &trans
            >;
        };

        nav_layer {
            display-name = "nav";
// ---------------------------------------------------------------------------------------------------------
// |       |     |      |      |       |       |                  |      |       |        |       |     |      |
// | BTCLR |tog0 | PREV | NEXT | VOL-  | VOL+  |                  | HOME | ^LEFT | ^BSPC  |^RIGHT | END | BSPC |
// | EXTPWR| BT1 | BT2  | BT3  |  BT4  |  BT5  |                  | LEFT | DOWN  |   UP   | RIGHT |  \  | F12  |
// | SHIFT | F1  |  F2  |  F3  |  F4   |  F5   |      |    |      |  F6  |  F7   |   F8   |  F9   | F10 | F11  |
//               |      |      | GUI   |       |      |    |      |      | R-ALT |        |       |
            bindings = <
&trans            &trans        &trans        &trans        &trans        &trans                         &trans    &trans        &trans        &trans         &trans   &trans
&bt BT_CLR        &tog BASE     &kp C_PREV    &kp C_NEXT    &kp C_VOL_DN  &kp C_VOL_UP                   &kp HOME  &kp LC(LEFT)  &kp LC(BSPC)  &kp LC(RIGHT)  &kp END  &trans
&ext_power EP_TOG &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                   &kp LEFT  &kp DOWN      &kp UP        &kp RIGHT      &kp BSLH &kp F12
&trans            &kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &trans  &trans   &kp F6    &kp F7        &kp F8        &kp F9         &kp F10  &kp F11
                                &trans        &trans        &kp LGUI      &trans        &trans  &trans   &trans    &kp RALT      &trans        &trans
            >;
        };
    };
};
